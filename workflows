        "messages": {
          "values": [
            {
              "content": "=Actuá como un asistente que clasifica y diagnostica consultas de un taller de reparación de PC. A partir del asunto y el cuerpo del email, evaluá la prioridad, asigná un puntaje del 1 al 10 y dá un diagnóstico breve. Devolvé ÚNICAMENTE un objeto JSON válido, sin texto adicional, con exactamente estos campos: \"prioridad\" (valor \"alta\" o \"baja\"), \"puntaje\" (número entero del 1 al 10) y \"diagnostico\" (texto breve).\n\nAsunto: {{ $json.subject }}\n\nCuerpo: {{ $json.text }}"
            }
          ]
        },
        "options": {
          "maxTokens": 400
        }
      },
