      "name": "Clasificar y Diagnosticar",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "retryOnFail": true,
      "credentials": {
        "anthropicApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Toma el texto de la respuesta de Anthropic y extrae el JSON,\n// incluso si viene envuelto en texto adicional o en un bloque de código.\nlet raw = \"\";\nconst c = $json.content;\nif (Array.isArray(c) && c.length > 0 && c[0] && typeof c[0].text === \"string\") {\n  raw = c[0].text;\n} else if (typeof $json.text === \"string\") {\n  raw = $json.text;\n} else if (typeof c === \"string\") {\n  raw = c;\n}\n\nlet parsed = null;\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nif (match) {\n  try { parsed = JSON.parse(match[0]); } catch (e) { parsed = null; }\n}\n\nif (!parsed) {\n  return {\n    prioridad: null,\n    puntaje: null,\n    diagnostico: null,\n    parseError: true,\n    rawResponse: raw,\n  };\n}\n\nreturn {\n  prioridad: parsed.prioridad ?? null,\n  puntaje: parsed.puntaje ?? null,\n  diagnostico: parsed.diagnostico ?? null,\n  parseError: false,\n};"
      },
